{
  "name": "dsh",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3080, 3081, 8407],
  "portsAttributes": {
    "3080": { "label": "DSH (direct)", "onAutoForward": "ignore" },
    "3081": { "label": "DSH (rewrite proxy)", "onAutoForward": "openBrowser" },
    "8407": { "label": "AgentRouter egress", "onAutoForward": "ignore" }
  },
  // build-essential + python3: 首次 npx 安装 @deepseek-ai/dsh 需现场编译 node-pty
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential python3"
}
