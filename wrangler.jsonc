{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lwsnb",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  },
  "routes": [
    { "pattern": "www.lwsnb.dpdns.org", "custom_domain": true }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
